{
  "name": "local-coding-agent",
  "version": "0.4.1",
  "private": true,
  "scripts": {
    "dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:test": "npm --prefix desktop run test",
    "agent:check": "uv run python -m compileall agent",
    "agent:test": "uv run python -m unittest discover -s tests -v",
    "validate": "uv run python scripts/validation/check.py"
  }
}
